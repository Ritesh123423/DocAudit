# MongoDB Atlas connection string. Create a free cluster at https://www.mongodb.com/cloud/atlas
# and get this from "Connect" -> "Drivers". Include a database name in the path, e.g. /audit-doc-analyzer
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/audit-doc-analyzer?retryWrites=true&w=majority

# Port the server listens on. Render sets this automatically in production; used for local dev.
PORT=3001

# Comma-separated list of origins allowed to call this API in development.
# In production on Render, set this to your client's Render URL (e.g. https://audit-doc-analyzer-client.onrender.com)
CLIENT_ORIGIN=http://localhost:5173

# OCR.space API key (free tier, no credit card required). Used to extract text
# from scanned PDFs and images. Get a free key at https://ocr.space/ocrapi
# (click "Free API Key", enter your email, the key arrives instantly).
# Without this set, scanned/image documents will be flagged "Needs OCR" but
# not actually processed.
OCR_SPACE_API_KEY=
